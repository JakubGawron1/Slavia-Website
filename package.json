{
  "name": "Slavia-frontend",
  "private": true,
  "type": "module",
  "version": "5.0.0",
  "scripts": {
    "build": "node --max-old-space-size=8192 ./node_modules/nuxt/bin/nuxt.mjs build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "serve": "node .output/server/index.mjs",
    "start": "node .output/server/index.mjs",
    "postinstall": "git submodule update --init --recursive --remote && nuxt prepare",
    "shared:pull": "git submodule update --init --recursive --remote Slavia-shared",
    "lint": "eslint .",
    "openapi:snapshot": "node scripts/sync-openapi-snapshot.mjs",
    "openapi:types": "node scripts/openapi-generate-types.mjs",
    "openapi:check": "node scripts/check-openapi-types.mjs",
    "shared:test": "node scripts/run-shared-test.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "nuxt typecheck",
    "test:e2e": "playwright test",
    "smoke:backend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-backend.ps1",
    "release:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release-check.ps1"
  },
  "dependencies": {
    "@slavia/shared": "file:./Slavia-shared",
    "@iconify-json/game-icons": "^1.2.4",
    "@iconify-json/lucide": "^1.2.108",
    "@iconify/utils": "^3.1.3",
    "@netlify/blobs": "^10.7.7",
    "@nuxt/devalue": "^2.0.2",
    "@nuxt/ui": "^4.7.1",
    "@tensorflow-models/pose-detection": "^2.1.3",
    "@tensorflow/tfjs": "^4.22.0",
    "@tiptap/core": "^3.23.4",
    "@tiptap/extension-color": "^3.23.4",
    "@tiptap/extension-highlight": "^3.23.4",
    "@tiptap/extension-image": "^3.23.4",
    "@tiptap/extension-link": "^3.23.4",
    "@tiptap/extension-placeholder": "^3.23.4",
    "@tiptap/extension-text-align": "^3.23.4",
    "@tiptap/extension-text-style": "^3.23.4",
    "@tiptap/extension-underline": "^3.23.4",
    "@tiptap/starter-kit": "^3.23.4",
    "@tiptap/vue-3": "^3.23.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.3.3",
    "date-fns": "^4.1.0",
    "html5-qrcode": "^2.3.8",
    "isomorphic-dompurify": "^3.13.0",
    "nuxt": "^4.4.5",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.15.2",
    "@nuxtjs/robots": "^6.0.8",
    "@nuxtjs/sitemap": "^8.0.15",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.8.0",
    "@types/qrcode": "^1.5.6",
    "@vite-pwa/nuxt": "^1.1.1",
    "esbuild": "0.28.0",
    "eslint": "^10.4.0",
    "openapi-typescript": "^7.13.0",
    "sass": "^1.100.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.2.9"
  },
  "packageManager": "pnpm@11.5.1+sha512.93f7b57422ea7068257235b4c16eb60762eb68e1dc23723199cc739043ea9be2c4143274a399d8c6defa2b1176226d9ca1c4b63482d6200c1a8fbaa78c1d1485"
}
