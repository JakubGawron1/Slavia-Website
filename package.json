{
  "name": "Slavia-frontend",
  "private": true,
  "type": "module",
  "version": "3.1.2-dev",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "serve": "node .output/server/index.mjs",
    "start": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test:e2e": "playwright test",
    "smoke:backend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-backend.ps1",
    "release:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release-check.ps1"
  },
  "dependencies": {
    "@iconify-json/game-icons": "^1.2.4",
    "@iconify-json/lucide": "^1.2.106",
    "@iconify/utils": "^3.1.3",
    "@netlify/blobs": "^10.7.4",
    "@nuxt/ui": "^4.7.1",
    "@tensorflow-models/pose-detection": "^2.1.3",
    "@tensorflow/tfjs": "^4.22.0",
    "@tiptap/core": "^3.23.1",
    "@tiptap/extension-color": "^3.23.1",
    "@tiptap/extension-highlight": "^3.23.1",
    "@tiptap/extension-image": "^3.23.1",
    "@tiptap/extension-link": "^3.23.1",
    "@tiptap/extension-placeholder": "^3.23.1",
    "@tiptap/extension-text-align": "^3.23.1",
    "@tiptap/extension-text-style": "^3.23.1",
    "@tiptap/extension-underline": "^3.23.1",
    "@tiptap/starter-kit": "^3.23.1",
    "@tiptap/vue-3": "^3.23.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.3.3",
    "date-fns": "^4.1.0",
    "isomorphic-dompurify": "^3.12.0",
    "nuxt": "^4.4.4",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.15.2",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.2",
    "esbuild": "0.28.0",
    "eslint": "^10.3.0",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.2.8"
  },
  "packageManager": "pnpm@11.0.9+sha512.34ce82e6780233cf9cad8685029a8f81d2e06196c5a9bad98879f7424940c6817c4e4524fb7d38b8553ceed48b9758b8ebaf1abd3600c232c4c8cf7366086f38",
  "pnpm": {
    "allowBuilds": {
      "@parcel/watcher": true,
      "@tailwindcss/oxide": true,
      "core-js": true,
      "esbuild": true,
      "unrs-resolver": true,
      "vue-demi": true
    },
    "confirmModulesPurge": false,
    "overrides": {
      "@tiptap/core": "3.23.1",
      "@tiptap/pm": "3.23.1"
    }
  }
}
