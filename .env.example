# Lokalny dev — backend na maszynie (bez końcowego slasha)
NUXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8080
# Vercel build + produkcja: ustaw prawdziwe URL (wymagane do BFF /api/public/*)
# NUXT_PUBLIC_API_BASE_URL_HUGGINGFACE=https://koliber-cks-slavia.hf.space
# NUXT_PUBLIC_API_BASE_URL_RENDER=https://twoj-backend.onrender.com
NUXT_PUBLIC_API_BASE_URL_HUGGINGFACE=http://127.0.0.1:8080
NUXT_PUBLIC_API_BASE_URL_RENDER=http://127.0.0.1:8080
# Publiczny adres frontendu (SEO, canonical, OG, sitemap, PWA scope)
# Na produkcji / Vercel Preview: ustaw jawny URL (bez końcowego slasha).
# Gdy puste — na Vercel używany jest VERCEL_URL; lokalnie localhost.
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Domyślny provider (gdy storage jest pusty): huggingface | render (deprecated)
# Vercel Preview (VERCEL_ENV=preview) zawsze używa huggingface.
DEFAULT_BACKEND_PROVIDER=huggingface

# Vercel Blob (globalny zapis przełącznika bez klasycznej bazy):
# BLOB_READ_WRITE_TOKEN=...

# Netlify Blobs działa bez dodatkowych zmiennych po stronie Netlify runtime.

# Repozytorium APK (GitHub Releases) — proxy `/api/mobile/latest-release`
# NUXT_PUBLIC_MOBILE_GITHUB_REPO=JakubGawron1/Slavia-Mobile
# Opcjonalnie PAT przy limicie API / prywatnym repo:
# GITHUB_TOKEN=

# Repo mediów Slavia-cms — galeria / blog (ścieżki względne z backendu)
# NUXT_PUBLIC_CMS_BASE_URL=https://raw.githubusercontent.com/JakubGawron1/Slavia-cms/main
# Upload idzie przez backend (GITHUB_TOKEN tylko na backendzie — nie w przeglądarce).
